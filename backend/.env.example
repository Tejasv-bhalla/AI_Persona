APP_ENV=local
ALLOWED_ORIGINS=http://localhost:5173

GROQ_API_KEY=
GROQ_GUARD_MODEL=qwen/qwen3.8-27b
GROQ_VOICE_MODEL=qwen/qwen3.8-27b
GROQ_GENERATION_MODEL=qwen/qwen3.8-27b
GROQ_GRADER_MODEL=qwen/qwen3.8-27b

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=tejasv_knowledge_base

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_USERNAME=

# Vapi
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=

# Voice behaviour
VOICE_MAX_RESPONSE_WORDS=80
VOICE_CACHE_TTL_SECONDS=3600


# Shared secret for the offline eval harness. Leave empty to disable /chat/eval (404).
EVAL_API_KEY=
# Rate limits (slowapi syntax, e.g. "20/minute", "5/hour")
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_VOICE=60/minute
RATE_LIMIT_BOOK=5/hour
# Fallback model used when the primary generation model is unavailable
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Max entries held in the in-process voice response cache
VOICE_CACHE_MAX_ENTRIES=256

# Groq free tier: 1000 output tokens/min, admitted against max_tokens.
# guard + generation + grader must sum below that ceiling.
MAX_OUTPUT_TOKENS_JSON=200
MAX_OUTPUT_TOKENS_CHAT=500
MAX_OUTPUT_TOKENS_VOICE=300
